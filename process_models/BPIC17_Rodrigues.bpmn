  <process id="bpic17_rodrigues" name="BPIC17 nach Rodrigues et al." isExecutable="false">
    <documentation>BPIC17-Prozessmodell nach Abb. 5 (finales Petri-Netz) aus Rodrigues et al., Stairway to value: mining a loan application process, BPI Challenge 2017. Von Hand erstelltes As-Is-Modell, kein normatives Soll-Modell. Enthält 11 von 26 Aktivitäten (O_Create Offer an zwei Stellen); alle anderen vor dem Vergleich herausfiltern.Aus der Abbildung nachgebaut, die Originaldatei ist nicht veröffentlicht.</documentation>
    <startEvent id="start">
      <outgoing>flow_0</outgoing>
    </startEvent>
    <endEvent id="end">
      <incoming>flow_32</incoming>
    </endEvent>
    <task id="create" name="A_Create Application">
      <incoming>flow_0</incoming>
      <outgoing>flow_1</outgoing>
    </task>
    <exclusiveGateway id="p9" gatewayDirection="Diverging">
      <incoming>flow_1</incoming>
      <outgoing>flow_2</outgoing>
      <outgoing>flow_3</outgoing>
    </exclusiveGateway>
    <task id="leads" name="W_Handle leads">
      <incoming>flow_2</incoming>
      <outgoing>flow_4</outgoing>
    </task>
    <exclusiveGateway id="p1" gatewayDirection="Converging">
      <incoming>flow_3</incoming>
      <incoming>flow_4</incoming>
      <outgoing>flow_5</outgoing>
    </exclusiveGateway>
    <task id="concept" name="A_Concept">
