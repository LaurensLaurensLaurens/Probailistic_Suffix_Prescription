<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SimRepair" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_SimRepair" name="SimRepair Reparaturprozess" isExecutable="false">
    <bpmn:startEvent id="start" name="Fall startet">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="initiate_case" name="initiate_case">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_proc" name="Verfahren?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="start_priority" name="start_priority">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="start_standard" name="start_standard">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="M_wait">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="wait_for_employee" name="wait_for_employee">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_take" name="Mitarbeiter nehmen?&#10;(Werkstatt-Policy)">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="use_spare_parts" name="use_spare_parts">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="repair_priority" name="repair_priority">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_x1" name="Reparatur gut?&#10;(Zufall)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="prepare_rerepair_priority" name="prepare_rerepair_priority">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="M_emp">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="choose_employee" name="choose_employee">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="M_mat">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="choose_material" name="choose_material">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_x2" name="Material bestellt?&#10;(Zufall)">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="repair_standard" name="repair_standard">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_x3" name="Reparatur gut?&#10;(Zufall)">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="prepare_rerepair_standard" name="prepare_rerepair_standard">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="M_qc">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_qc" name="Qualitätskontrolle?&#10;(Werkstatt-Policy)">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="conduct_qc" name="conduct_qc">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="improve_rework" name="improve_rework">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="shipping" name="shipping">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_accept" name="Kunde nimmt an?&#10;(Zufall)">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="customer_acceptance" name="customer_acceptance">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="customer_refusal" name="customer_refusal">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_accept" name="Angenommen">
      <bpmn:incoming>Flow_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_refuse" name="Abgelehnt">
      <bpmn:incoming>Flow_35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="initiate_case" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="initiate_case" targetRef="G_proc" />
    <bpmn:sequenceFlow id="Flow_3" name="start_priority" sourceRef="G_proc" targetRef="start_priority" />
    <bpmn:sequenceFlow id="Flow_4" name="start_standard" sourceRef="G_proc" targetRef="start_standard" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="start_priority" targetRef="M_wait" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="M_wait" targetRef="wait_for_employee" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="wait_for_employee" targetRef="G_take" />
    <bpmn:sequenceFlow id="Flow_8" name="ja" sourceRef="G_take" targetRef="use_spare_parts" />
    <bpmn:sequenceFlow id="Flow_9" name="nein, weiter warten (max. 3x)" sourceRef="G_take" targetRef="M_wait" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="use_spare_parts" targetRef="repair_priority" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="repair_priority" targetRef="G_x1" />
    <bpmn:sequenceFlow id="Flow_12" name="nein (max. 3x)" sourceRef="G_x1" targetRef="prepare_rerepair_priority" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="prepare_rerepair_priority" targetRef="M_wait" />
    <bpmn:sequenceFlow id="Flow_14" name="ja" sourceRef="G_x1" targetRef="M_qc" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="start_standard" targetRef="M_emp" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="M_emp" targetRef="choose_employee" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="choose_employee" targetRef="M_mat" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="M_mat" targetRef="choose_material" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="choose_material" targetRef="G_x2" />
    <bpmn:sequenceFlow id="Flow_20" name="nein, vergessen" sourceRef="G_x2" targetRef="M_mat" />
    <bpmn:sequenceFlow id="Flow_21" name="ja" sourceRef="G_x2" targetRef="repair_standard" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="repair_standard" targetRef="G_x3" />
    <bpmn:sequenceFlow id="Flow_23" name="nein (max. 3x)" sourceRef="G_x3" targetRef="prepare_rerepair_standard" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="prepare_rerepair_standard" targetRef="M_emp" />
    <bpmn:sequenceFlow id="Flow_25" name="ja" sourceRef="G_x3" targetRef="M_qc" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="M_qc" targetRef="G_qc" />
    <bpmn:sequenceFlow id="Flow_27" name="conduct_qc (max. 3x)" sourceRef="G_qc" targetRef="conduct_qc" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="conduct_qc" targetRef="improve_rework" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="improve_rework" targetRef="M_qc" />
    <bpmn:sequenceFlow id="Flow_30" name="shipping" sourceRef="G_qc" targetRef="shipping" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="shipping" targetRef="G_accept" />
    <bpmn:sequenceFlow id="Flow_32" name="ja" sourceRef="G_accept" targetRef="customer_acceptance" />
    <bpmn:sequenceFlow id="Flow_33" name="nein" sourceRef="G_accept" targetRef="customer_refusal" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="customer_acceptance" targetRef="end_accept" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="customer_refusal" targetRef="end_refuse" />
    <bpmn:textAnnotation id="A_proc"><bpmn:text>Entscheidungspunkt der Intervention choose_procedure (aktiv, Stage 1): Prefix endet mit initiate_case, Aktion = start_standard oder start_priority. Historisch entscheidet die Werkstatt-Policy nach bike_value, repair_severity, quality_uncertainty.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_qc"><bpmn:text>Möglicher weiterer Entscheidungspunkt (Intervention conduct_qc, derzeit nicht aktiv): nach repair_priority, repair_standard oder improve_rework. Aktion = shipping oder conduct_qc.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_qc_effect"><bpmn:text>conduct_qc senkt quality_uncertainty auf 40 % des bisherigen Werts (mindestens 0,05).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_outcome"><bpmn:text>Outcome am Fallende: bei Annahme (10 + 2*bike_value + repair_severity) * (1 - 0,3*quality_uncertainty) - Tage; bei Ablehnung -Tage.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_branches"><bpmn:text>Priority: Mitarbeiter und Material werden zufällig zugeteilt (schnell). Standard: Werkstatt wählt Mitarbeiter und Material passend zum Fall (langsamer).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A_proc" sourceRef="G_proc" targetRef="A_proc" />
    <bpmn:association id="Assoc_A_qc" sourceRef="G_qc" targetRef="A_qc" />
    <bpmn:association id="Assoc_A_qc_effect" sourceRef="conduct_qc" targetRef="A_qc_effect" />
    <bpmn:association id="Assoc_A_outcome" sourceRef="customer_refusal" targetRef="A_outcome" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_SimRepair">
